  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#00F0FF>You are the bullet. You never stop flying.</color>\n\n<b>MOUSE</b>         
    steer\n<b>RIGHT MOUSE</b>    deadeye \u2014 slow time to line up a shot\n<b>ESC
    / P</b>        pause\n\nFly through glowing <color=#00F0FF>cores</color> to refuel
    your speed.\nGraze a wall at a shallow angle to <color=#FFE600>ricochet</color>.\nHit
    a wall head-on and you're done.\nSlow to a crawl and you fall out of the air.\n\n<color=#FF2A6D>Stay
    fast. Stay flying.</color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5a20bab69d42bd94bb030d1e833ff304, type: 2}
